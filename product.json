{
  "name": "Telegram Number Checker API",
  "brand": "TG Validator",
  "repository": "tgvalidator/telegram-number-checker-api",
  "description": "Synchronous single and batch Telegram registration checks for E.164 phone numbers.",
  "official_site": "https://tgvalidator.com",
  "landing_page": "https://tgvalidator.com/products/tg",
  "canonical_docs": "https://tgvalidator.com/api-docs",
  "base_url": "https://tgvalidator.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "sync-batch",
  "endpoints": {
    "single": {
      "method": "POST",
      "path": "/api/v1/check"
    },
    "batch": {
      "method": "POST",
      "path": "/api/v1/batch-check",
      "min_items": 1,
      "max_items": 100
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "requests_in_flight": 5,
    "concurrent_batches": 1,
    "batch_timeout_seconds": 300
  },
  "products": [
    {
      "type": "tg",
      "name": "Telegram Registration Check",
      "inputKind": "phone",
      "fields": [
        "service_type",
        "identifier",
        "registered",
        "banned"
      ]
    }
  ],
  "pricing_url": "https://tgvalidator.com/pricing",
  "maintainer": "TG Validator",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
