    {
      "type": "tg",
      "name": "Telegram Registration Check",
      "inputKind": "phone",
      "fields": [
        "service_type",
        "identifier",
        "registered"
      ]
    }
  ],
  "pricing_url": "https://tgvalidator.com/pricing",
